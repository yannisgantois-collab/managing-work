{
  "name": "StealAKeyboard",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "Notify": { "$className": "RemoteEvent" },
        "Effect": { "$className": "RemoteEvent" },
        "SaveSettings": { "$className": "RemoteEvent" },
        "Shop": { "$className": "RemoteFunction" }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 70
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -400
      },
      "Map": {
        "$path": "build/Map.rbxm"
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "ClockTime": 17.4,
        "GeographicLatitude": 30,
        "Brightness": 2.2,
        "Ambient": [0.36, 0.33, 0.4],
        "OutdoorAmbient": [0.55, 0.5, 0.56],
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6,
        "GlobalShadows": true,
        "ExposureCompensation": 0.15
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.33,
          "Offset": 0.15,
          "Color": [1, 0.85, 0.75],
          "Decay": [0.55, 0.45, 0.6],
          "Glare": 0.35,
          "Haze": 1.8
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.85,
          "Size": 30,
          "Threshold": 1.4
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.06,
          "Saturation": 0.12,
          "TintColor": [1, 0.98, 0.97]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.05,
          "Spread": 0.6
        }
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
